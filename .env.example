# ---- production (docker-compose.prod.yml). Copy to .env and fill in. NEVER commit .env ----
DOMAIN=notes.example.com          # a domain pointing at the server (or <ip>.sslip.io)
GITHUB_URL=https://github.com/YOUR-USERNAME/audio-notes
POSTGRES_PASSWORD=change-me

# Object storage: any S3-compatible bucket you create (R2, B2, Supabase, AWS S3...)
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=audio-notes
S3_REGION=auto
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# Must be gnani for the real thing. gemini is for development only (saves Gnani credits).
TRANSCRIPTION_PROVIDER=gnani
GNANI_API_KEY=...
GEMINI_API_KEY=...
GEMINI_MODEL=set-a-currently-available-gemini-model
